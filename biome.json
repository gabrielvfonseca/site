{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/.source",
			"!**/.next",
			"!**/.turbo",
			"!**/dist",
			"!**/coverage",
			"!**/.claude/skills",
			"!**/skills",
			"!**/*.min.js"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"html": {
		"parser": {
			"interpolation": true
		}
	},
	"linter": {
		"rules": {
			"complexity": {
				"noImportantStyles": "off"
			},
			"correctness": {
				"useImageSize": "warn"
			},
			"performance": {
				"noImgElement": "warn"
			},
			"security": {
				"noDangerouslySetInnerHtml": "warn"
			},
			"style": {
				"useNamingConvention": {
					"level": "warn",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": { "kind": "const" },
								"formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
							},
							{
								"selector": { "kind": "objectLiteralMember" },
								"formats": [
									"camelCase",
									"CONSTANT_CASE",
									"PascalCase",
									"snake_case"
								]
							},
							{
								"selector": { "kind": "typeMember" },
								"formats": [
									"camelCase",
									"CONSTANT_CASE",
									"PascalCase",
									"snake_case"
								]
							}
						]
					}
				}
			},
			"suspicious": {
				"noConsole": "warn",
				"useAwait": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["types/**/*.d.ts", "**/*.d.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"noBannedTypes": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/supabase/src/types/db.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"noBannedTypes": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/supabase/src/utils/storage.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": ["infrastructure/supabase/templates/*.html"],
			"formatter": {
				"enabled": false
			}
		}
	]
}
