{
  "name": "@gabfon/cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized Cloudflare REST API v4 client and typed helpers for gabfon.com",
  "keywords": [
    "api",
    "client",
    "cloudflare",
    "email-sending"
  ],
  "homepage": "https://gabfon.com",
  "bugs": {
    "url": "https://github.com/gabriel-fonseca/site-main/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Gabriel Fonseca",
    "email": "hey@gabfon.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gabriel-fonseca/site-main"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./keys": {
      "types": "./src/keys.ts",
      "import": "./src/keys.ts",
      "default": "./src/keys.ts"
    },
    "./email": {
      "types": "./src/email.ts",
      "import": "./src/email.ts",
      "default": "./src/email.ts"
    }
  },
  "scripts": {
    "build": "bunx tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "analyze": "echo 'No analysis specified'",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "bunx tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@gabfon/testing": "workspace:*",
    "@gabfon/typescript-config": "workspace:*",
    "@types/node": "24.10.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
